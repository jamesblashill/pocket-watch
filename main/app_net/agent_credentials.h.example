#pragma once

/* Copy this file to agent_credentials.h (gitignored) and fill in your
 * pocket-watch-backend deployment's details. agent_credentials.h is
 * included directly by app_agent/agent.c and is never checked into the
 * repo - same pattern as wifi_credentials.h. */

/* ws:// for a plain local-network backend, wss:// once it sits behind TLS. */
#define AGENT_BACKEND_WS_URL "ws://your-backend-host:3002/ws/agent"

/* Must match DEVICE_SHARED_SECRET in pocket-watch-backend's .env */
#define AGENT_DEVICE_SHARED_SECRET "changeme"
